# 复制为 .env 后按需修改：cp .env.example .env（./setup.sh 首次运行会自动复制）
# ⚠️ NAS / 生产部署务必修改下面的密钥与密码

# 仅用于 auth-service 的 OAuth state / 绑定凭证 HMAC。
# 登录 token 由 auth-service 的 ES256 私钥签发（首次启动自动生成到 auth_keys 卷），其他服务通过 JWKS 校验，无需共享密钥。
JWT_SECRET=change-me-to-a-long-random-string

# 数据库密码
POSTGRES_PASSWORD=change-me

# ── 首次部署：初始管理员 ──
# 只有在系统里一个管理员（users.user_role=1）都没有时才会执行。
# 邮箱已存在：只提权，不改密码；邮箱不存在：必须提供初始密码，自动创建账号。
# 首次启动成功后建议删除 BOOTSTRAP_ADMIN_PASSWORD，避免明文密码长期留在 .env。
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NICKNAME=
# 仅当邮箱已存在、且确实要强制重置该账号密码时设为 true；默认 false
BOOTSTRAP_ADMIN_RESET_PASSWORD=false

# gateway 管理后台 break-glass 邮箱白名单（逗号分隔）。
# 常规管理员权限以 users.user_role=1 为准，可在网页后台修改；
# 这里只用于 node-api 不可用时仍能进入后台。
GATEWAY_ADMIN_EMAILS=

# gateway 机器 token（Prometheus / 脚本访问 /metrics 用，不是网页登录密码）
GATEWAY_ADMIN_TOKEN=change-me

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App credentials (separate from the gateway's GITHUB_TOKEN)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Public API origin used as the OAuth callback base.
# Callback paths are routed by the gateway to the Go API.
# Register `${OAUTH_CALLBACK_BASE_URL}/auth/google/callback` and
# `${OAUTH_CALLBACK_BASE_URL}/auth/github/callback` with the providers.
OAUTH_CALLBACK_BASE_URL=https://api.moelink.site

# Exact frontend origins permitted to receive the final login redirect.
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://moelink.site,https://www.moelink.site,https://quiz.moelink.site,http://localhost:3000,http://localhost:5173,http://localhost:8000,https://api.moelink.site

# 登录会话 Cookie 的共享域名：线上设为 .moelink.site，使所有子站共用登录。
# ⚠️ 本地开发（localhost）必须留空，否则浏览器会拒收 Cookie。
SESSION_COOKIE_DOMAIN=.moelink.site

# 站外应用（不在 moelink.site 下的项目）单点登录登记表，JSON 数组；没有就留空。
# 例：[{"id":"app","name":"显示名","redirect_uris":["https://app.example/callback"]}]
SSO_CLIENTS=

# Share the OAuth state cookie between quiz.moelink.site and api.moelink.site.
# Leave empty for local development; set to .moelink.site for production subdomains.
OAUTH_COOKIE_DOMAIN=.moelink.site

# gateway release guardian 读取 GitHub 用（可留空）
GITHUB_TOKEN=

# postgres 映射到宿主机的端口（默认 5432；NAS 上被占用时改成 5433 等）
POSTGRES_HOST_PORT=5432

# 小屋编辑权限：独立于 user_role 的站长邮箱白名单（逗号分隔）
MIAO_OWNER_EMAILS=

# ── 监控 / 邮件 / 存储（均可留空）──
# Sentry DSN：Go 后端与 node-api 分开配置
GO_SENTRY_DSN=
NODE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Go 后端：前端域名、Resend 邮件、Azure 存储
APP_DOMAIN=https://quiz.moelink.site
RESEND_KEY=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=genshin-quiz

# node-api：/admin 登录密码与 session 签名密钥（./setup.sh --env 会自动生成）
ADMIN_SECRET=change-me
SESSION_SECRET=change-me

# MoeLink 前端 PrimeUI 授权密钥（构建时内联进前端包；留空则界面出现授权提示）
# 申请：https://primeui.store/primeui
VITE_PRIMEUI_LICENSE_KEY=

# 三个前端的构建版本水印；留空时自动使用构建时间戳（YYYYMMDD-HHmm）
# 线上可以填 git commit，例如：VITE_BUILD_VERSION=3f2a1c9
# 同时作用于 GenshinQuiz 前端和 MoeLink 前端
VITE_BUILD_VERSION=
# Guardian Dashboard 的构建版本；留空时由镜像构建时间戳生成
# 想和前端保持同一个标识时，填相同的值即可
GATEWAY_BUILD_VERSION=
