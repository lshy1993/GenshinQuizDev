# 复制为 .env 后按需修改：cp .env.example .env（./setup.sh 首次运行会自动复制）
# ⚠️ NAS / 生产部署务必修改下面的密钥与密码

# MoeLink 统一登录签名密钥（node-api 与 genshinquiz-backend 必须一致）
JWT_SECRET=change-me-to-a-long-random-string

# 数据库密码
POSTGRES_PASSWORD=change-me

# gateway 管理后台允许登录的管理员 user_id（逗号分隔）
# 这些用户用 MoeLink 统一账号登录 gateway，必须是 users.user_role=1 的管理员
GATEWAY_ADMIN_USER_IDS=6

# gateway 机器 token（Prometheus / 脚本访问 /metrics 用，不是网页登录密码）
GATEWAY_ADMIN_TOKEN=change-me

# Google OAuth web application credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub OAuth App credentials (separate from the gateway's GITHUB_TOKEN)
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Public API origin used as the OAuth callback base.
# Callback paths are routed by the gateway to the Go API.
# Register `${OAUTH_CALLBACK_BASE_URL}/auth/google/callback` and
# `${OAUTH_CALLBACK_BASE_URL}/auth/github/callback` with the providers.
OAUTH_CALLBACK_BASE_URL=https://api.moelink.site

# Exact frontend origins permitted to receive the final login redirect.
OAUTH_ALLOWED_REDIRECT_ORIGINS=https://moelink.site,https://www.moelink.site,https://quiz.moelink.site,http://localhost:3000,http://localhost:5173

# Share the OAuth state cookie between quiz.moelink.site and api.moelink.site.
# Leave empty for local development; set to .moelink.site for production subdomains.
OAUTH_COOKIE_DOMAIN=.moelink.site

# gateway release guardian 读取 GitHub 用（可留空）
GITHUB_TOKEN=

# postgres 映射到宿主机的端口（默认 5432；NAS 上被占用时改成 5433 等）
POSTGRES_HOST_PORT=5432

# 小屋编辑权限：允许写入的 user_id，逗号分隔
MIAO_OWNER_USER_IDS=6

# ── 监控 / 邮件 / 存储（均可留空）──
# Sentry DSN：Go 后端与 node-api 分开配置
GO_SENTRY_DSN=
NODE_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1

# Go 后端：前端域名、Resend 邮件、Azure 存储
APP_DOMAIN=https://quiz.moelink.site
RESEND_KEY=
AZURE_STORAGE_ACCOUNT=
AZURE_STORAGE_KEY=
AZURE_CONTAINER_NAME=genshin-quiz

# node-api：/admin 登录密码与 session 签名密钥（./setup.sh --env 会自动生成）
ADMIN_SECRET=change-me
SESSION_SECRET=change-me

# MoeLink 前端 PrimeUI 授权密钥（构建时内联进前端包；留空则界面出现授权提示）
# 申请：https://primeui.store/primeui
VITE_PRIMEUI_LICENSE_KEY=
